alias cd='echo "💜 💙 💚 " ; cd'

ls --color=auto &>/dev/null
if [ $? -eq 0 ]; then
    alias ls='ls -GF --color=auto'
else
    alias ls='ls -GF'
fi
alias ll='ls -l'
alias sudo='sudo ' # allow for aliases to work when using sudo

alias b='buoy $(< ~/.dotfiles/buoy)'
alias g=git
alias c='docker compose'
alias d=docker
alias m=make

alias ~='cd ~'
alias -- -='cd -'
alias ..='cd ..'
alias ...='cd ../..'

alias dotfiles="cd ~/.dotfiles"

# mosh execs the command directly rather than through a login shell, so zsh -i
# is needed to source ~/.zshrc and pick up mise's shims. Local echo is disabled
# because mosh predicts keystrokes against the full terminal width and paints
# them across zellij's pane boundaries.
alias bob='mosh --predict=never bob -- zsh -ic "zellij attach -c dev"'
